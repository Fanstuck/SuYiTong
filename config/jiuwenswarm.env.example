# 复制所需值到 runtime/.jiuwenswarm/config/.env；不要提交真实密钥。
# API_BASE 不包含 /chat/completions 后缀。
API_BASE=https://api.example.com/v1
API_KEY=replace-with-real-secret
MODEL_NAME=replace-with-model-id
MODEL_PROVIDER=OpenAI
CUSTOM_HEADERS=

# 速易通轻量模式：仅保留本地 Web，不加载 IM/手机渠道 SDK。
SUYITONG_LITE_MODE=true

# 可选：论文证据检索和语义记忆。
OPENALEX_API_KEY=
EMBED_API_BASE=
EMBED_API_KEY=
EMBED_MODEL=
JINA_API_KEY=
SERPER_API_KEY=
PERPLEXITY_API_KEY=

# 首期关闭未经评测和人工批准的自动演进。
EVOLUTION_AUTO_SCAN=false
